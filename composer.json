{
    "name": "we-simply-code/laravel-afas-rest-connector",
    "description": "This package integrates the AFAS REST API with Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sunil Kisoensingh",
            "email": "sunil.kisoensingh@gmail.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0|^8.1|^8.2",
        "illuminate/support": "^8|^9|^10|^11|^12|^13",
        "guzzlehttp/guzzle": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "WeSimplyCode\\LaravelAfasRestConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeSimplyCode\\LaravelAfasRestConnector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:docker": "./docker-test.sh"
    },
    "extra": {
        "laravel": {
            "providers": [
                "WeSimplyCode\\LaravelAfasRestConnector\\LaravelAfasRestConnectorServiceProvider"
            ],
            "aliases": {
                "Afas": "WeSimplyCode\\LaravelAfasRestConnector\\Facades\\Afas"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
